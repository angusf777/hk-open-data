{
  "name": "hk-open-data",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "catalog:validate": "uv run python scripts/catalog.py validate",
    "catalog:generate": "uv run python scripts/catalog.py generate",
    "catalog:check": "uv run python scripts/catalog.py check",
    "access:validate": "uv run python scripts/access.py validate",
    "access:generate": "uv run python scripts/access.py generate",
    "access:check": "uv run python scripts/access.py check",
    "test": "pnpm -r --if-present test && uv run pytest -q",
    "test:browser": "playwright test",
    "test:contract": "pnpm --filter @hk-open-data/api test -- openapi-contract.test.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "check:boundary": "node scripts/check-public-boundary.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
