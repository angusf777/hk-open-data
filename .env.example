# Safe defaults: the catalogue profile never contacts providers.
HKOD_PROFILE=catalogue
HKOD_ENABLE_PROVIDER_ACCESS=false
HKOD_ENABLE_RAW_EVIDENCE=false
TRUSTED_PROXY_CIDRS=

POSTGRES_DB=hk_open_data
POSTGRES_ADMIN_USER=hk_admin
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_WEBHOOK_PASSWORD=

# Required only by the explicit fabric profile. Supply values through an ignored .env or secret
# manager; never commit functional credentials.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=raw-snapshots

OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=https://api.example.invalid
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
WEBHOOK_SECRET_ENCRYPTION_KEY=
PLATFORM_API_URL=http://127.0.0.1:3000/v1
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
