{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hk-public-data:schema:mcp-allowlist-record:1",
  "title": "MCP Server Allowlist Record",
  "type": "object",
  "required": ["server_id", "repository_url", "status", "projects", "evidence"],
  "properties": {
    "server_id": {"type": "string", "pattern": "^MCP-[0-9]{3}$"},
    "namespace": {"type": ["string", "null"]},
    "repository_url": {"type": "string", "format": "uri"},
    "package": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "artifact_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "approved_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "denied_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "transport": {"type": ["string", "null"], "enum": ["stdio", "streamable_http", "sse", "other", null]},
    "allowed_network_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "filesystem_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "auth_profile": {"type": ["string", "null"]},
    "secrets_profile": {"type": ["string", "null"]},
    "read_only": {"type": ["boolean", "null"]},
    "human_approval_required": {"type": ["boolean", "null"]},
    "projects": {"type": "array", "items": {"type": "string", "pattern": "^P[0-9]{2}$"}, "uniqueItems": true},
    "owner": {"type": ["string", "null"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["candidate", "approved", "restricted", "quarantined", "revoked", "expired"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["approved", "restricted"]}}, "required": ["status"]},
      "then": {
        "required": ["package", "version", "artifact_hash", "approved_tools", "denied_tools", "transport", "allowed_network_hosts", "filesystem_roots", "read_only", "human_approval_required", "owner", "approved_by", "approved_at", "expires_at"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "transport": {"enum": ["stdio", "streamable_http", "sse", "other"]},
          "owner": {"type": "string", "minLength": 1},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ],
  "additionalProperties": false
}
