{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hk-public-data:schema:canonical-event:1",
  "title": "P01 Canonical Event",
  "type": "object",
  "required": ["event_id", "event_type", "status", "severity", "title", "summary", "source_records", "observed_at", "quality_flags", "schema_version"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9_-]{8,128}$"},
    "event_type": {"enum": ["source.new", "source.changed", "source.removed", "source.suspended", "warning.issued", "warning.updated", "warning.cancelled", "threshold.exceeded", "route.disrupted", "service.disrupted", "licence.changed", "legislation.changed", "bill.changed", "facility.availability_changed"]},
    "status": {"enum": ["anticipated", "active", "updated", "resolved", "cancelled", "historical"]},
    "severity": {"enum": ["informational", "minor", "moderate", "major", "critical", "unknown"]},
    "title": {"$ref": "#/$defs/localized_text"},
    "summary": {"$ref": "#/$defs/localized_text"},
    "original_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_record_id", "language", "text"],
        "properties": {
          "source_record_id": {"type": "string", "pattern": "^SR-[A-Za-z0-9_-]{8,128}$"},
          "language": {"type": "string", "minLength": 2},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "affected_entities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affected_geometry": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/geojson"}]},
    "observed_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "expected_end_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SR-[A-Za-z0-9_-]{8,128}$"}, "uniqueItems": true},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "description", "review_state"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "description": {"$ref": "#/$defs/localized_text"},
          "review_state": {"enum": ["draft", "reviewed", "rejected"]},
          "reviewed_by": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "schema_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "localized_text": {
      "type": "object",
      "required": ["en", "zh_Hant"],
      "properties": {
        "en": {"type": ["string", "null"]},
        "zh_Hant": {"type": ["string", "null"]},
        "zh_Hans": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"properties": {"en": {"type": "string", "minLength": 1}}},
        {"properties": {"zh_Hant": {"type": "string", "minLength": 1}}}
      ],
      "additionalProperties": false
    },
    "geojson": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon", "GeometryCollection", "Feature", "FeatureCollection"]},
        "coordinates": {"type": "array"},
        "geometries": {"type": "array"},
        "geometry": {"type": ["object", "null"]},
        "properties": {"type": ["object", "null"]},
        "features": {"type": "array"},
        "bbox": {"type": "array", "items": {"type": "number"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
