{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hk-public-data:schema:source-record:1",
  "title": "P01 Source Record",
  "type": "object",
  "required": [
    "source_record_id",
    "source_id",
    "operating_profile",
    "source_group_id",
    "provider",
    "authority_class",
    "retrieved_at",
    "content_type",
    "raw_payload_hash",
    "raw_storage_uri",
    "approval_reference",
    "schema_version",
    "freshness_status",
    "quality_flags",
    "parent_record_ids"
  ],
  "properties": {
    "source_record_id": {"type": "string", "pattern": "^SR-[A-Za-z0-9_-]{8,128}$"},
    "source_id": {"type": "string", "pattern": "^(HKAPI-[0-9]{3}|EXT-[0-9]{3}|SRC-[0-9]{3})$"},
    "catalogue_id": {"type": "string", "pattern": "^(official|external|mcp):[a-z0-9][a-z0-9-]*$"},
    "terms_evidence_state": {"enum": ["not-reviewed", "official-terms-linked", "restriction-identified", "ambiguity-identified", "provider-confirmation-recorded"]},
    "operating_profile": {"enum": ["catalogue", "observe", "fabric"]},
    "evidence_mode": {"enum": ["digest", "raw"]},
    "source_group_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "record_key": {"type": ["string", "null"], "maxLength": 512},
    "source_name": {"type": ["string", "null"], "maxLength": 512},
    "provider": {"type": "string", "minLength": 1, "maxLength": 512},
    "authority_class": {"enum": ["official", "contracted", "community", "derived", "model_generated", "synthetic"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "documentation_url": {"type": ["string", "null"], "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "language": {"type": ["string", "null"], "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "content_type": {"type": "string", "minLength": 1, "maxLength": 255},
    "http_metadata": {
      "type": ["object", "null"],
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "etag": {"type": ["string", "null"]},
        "last_modified": {"type": ["string", "null"]},
        "content_length": {"type": ["integer", "null"], "minimum": 0},
        "final_url": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    },
    "approval_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "rights_reference": {"type": ["string", "null"]},
    "attribution": {"type": ["string", "null"]},
    "raw_payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_storage_uri": {"type": "string", "pattern": "^(s3|gs|az|file|digest)://.+"},
    "schema_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"type": "string", "minLength": 1},
    "transform_version": {"type": ["string", "null"]},
    "freshness_status": {"enum": ["fresh", "aging", "stale", "expired", "unknown"]},
    "quality_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "parent_record_ids": {"type": "array", "items": {"type": "string", "pattern": "^SR-[A-Za-z0-9_-]{8,128}$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
