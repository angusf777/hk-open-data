{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hk-public-data:schema:connector-run:1",
  "title": "P01 Connector Run",
  "type": "object",
  "required": ["run_id", "connector_id", "connector_version", "source_group_id", "source_ids", "environment", "attempt", "started_at", "finished_at", "outcome", "request_count", "response_count", "record_count", "raw_object_ids", "error_codes"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^CR-[A-Za-z0-9_-]{8,128}$"},
    "connector_id": {"type": "string", "minLength": 1},
    "connector_version": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(HKAPI|EXT)-[0-9]{3}$"}, "uniqueItems": true},
    "environment": {"enum": ["local", "development", "staging", "production"]},
    "attempt": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["succeeded", "partial", "failed", "quarantined", "cancelled"]},
    "request_count": {"type": "integer", "minimum": 0},
    "response_count": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 0},
    "bytes_received": {"type": "integer", "minimum": 0},
    "checkpoint_before": {"type": ["string", "null"]},
    "checkpoint_after": {"type": ["string", "null"]},
    "raw_object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "error_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "correlation_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
