{
  "openapi": "3.1.0",
  "info": {
    "title": "HK Open Data Self-hosted Runtime",
    "version": "1.0.0-draft",
    "description": "Normative v0 REST surface. Public status operations are explicitly marked; all other operations require an audience-bound bearer token. Every operation is subject to the application rate limit and can return 429 with Retry-After."
  },
  "servers": [
    {"url": "/", "description": "Current environment; deployment supplies the origin"}
  ],
  "tags": [
    {"name": "Sources", "description": "Approved-source catalogue and health metadata"},
    {"name": "Access", "description": "Read-only technical access recipes and examples"},
    {"name": "Records", "description": "Immutable source records and provenance"},
    {"name": "Events", "description": "Normalized domain events"},
    {"name": "Quality", "description": "Reviewed target health and incident views"},
    {"name": "Webhooks", "description": "Authenticated event-delivery subscriptions"},
    {"name": "Administration", "description": "Audited approval and incident transitions"}
  ],
  "paths": {
    "/v1/sources": {
      "get": {
        "operationId": "listSources",
        "summary": "List visible sources",
        "tags": ["Sources"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "project", "in": "query", "schema": {"type": "string", "pattern": "^P[0-9]{2}$"}},
          {"name": "authority_class", "in": "query", "schema": {"type": "string"}},
          {"name": "freshness_status", "in": "query", "schema": {"type": "string"}},
          {"name": "approval_status", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Visible source summaries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourcePage"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/sources/{source_id}": {
      "get": {
        "operationId": "getSource",
        "summary": "Get one source and its current health",
        "tags": ["Sources"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/SourceId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "responses": {
          "200": {"description": "Source definition and current health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceDetail"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/access-recipes": {
      "get": {
        "operationId": "listAccessRecipes",
        "summary": "List source access recipes",
        "tags": ["Access"],
        "security": [{}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "adapter", "in": "query", "schema": {"$ref": "#/components/schemas/AccessAdapter"}},
          {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/AccessStatus"}},
          {"name": "authentication", "in": "query", "schema": {"enum": ["none", "api-key", "bearer", "basic", "oauth2", "registration"]}},
          {"name": "verification_freshness", "in": "query", "schema": {"enum": ["current", "stale", "never"]}}
        ],
        "responses": {
          "200": {"description": "Bounded source access recipes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRecipePage"}}}},
          "400": {"description": "Unsupported access-recipe filter", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/access-recipes/{source_reference}": {
      "get": {
        "operationId": "getAccessRecipe",
        "summary": "Get one source access recipe",
        "tags": ["Access"],
        "security": [{}],
        "parameters": [
          {"name": "source_reference", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^HKAPI-[0-9]{3}$"}}
        ],
        "responses": {
          "200": {"description": "One source access recipe", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRecipe"}}}},
          "400": {"description": "Invalid source reference", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/access-resources": {
      "get": {
        "operationId": "listAccessResources",
        "summary": "List mapped DATA.GOV.HK provider resources",
        "tags": ["Access"],
        "security": [{}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "source_reference", "in": "query", "schema": {"type": "string", "pattern": "^HKAPI-[0-9]{3}$"}},
          {"name": "dataset_id", "in": "query", "schema": {"type": "string"}},
          {"name": "format", "in": "query", "schema": {"type": "string"}},
          {"name": "access", "in": "query", "schema": {"$ref": "#/components/schemas/ResourceAccess"}}
        ],
        "responses": {
          "200": {"description": "Bounded provider resource metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessResourcePage"}}}},
          "400": {"description": "Unsupported resource filter", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/access-resources/{dataset_id}/{resource_id}": {
      "get": {
        "operationId": "getAccessResource",
        "summary": "Get one mapped DATA.GOV.HK provider resource",
        "tags": ["Access"],
        "security": [{}],
        "parameters": [
          {"name": "dataset_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "resource_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "One provider resource with usage commands", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessResource"}}}},
          "400": {"description": "Invalid provider resource identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/source-records": {
      "get": {
        "operationId": "querySourceRecords",
        "summary": "Query authorized source records",
        "tags": ["Records"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "source_id", "in": "query", "schema": {"type": "string"}},
          {"name": "observed_from", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "observed_to", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "published_from", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "published_to", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "language", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Authorized source records", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceRecordPage"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/source-records/{source_record_id}": {
      "get": {
        "operationId": "getSourceRecord",
        "summary": "Get one source record with lineage",
        "tags": ["Records"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "source_record_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "One source record with lineage", "content": {"application/json": {"schema": {"$ref": "./source_record.schema.json"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "queryEvents",
        "summary": "Query authorized canonical events",
        "tags": ["Events"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "event_type", "in": "query", "schema": {"type": "string"}},
          {"name": "status", "in": "query", "schema": {"type": "string"}},
          {"name": "severity", "in": "query", "schema": {"type": "string"}},
          {"name": "observed_from", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "observed_to", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "affected_entity", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Authorized canonical events", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/events/{event_id}": {
      "get": {
        "operationId": "getEvent",
        "summary": "Get one canonical event",
        "tags": ["Events"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "event_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "One canonical event", "content": {"application/json": {"schema": {"$ref": "./canonical_event.schema.json"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/status/summary": {
      "get": {
        "operationId": "getPublicStatusSummary",
        "summary": "Get the reviewed public status summary",
        "tags": ["Quality"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"name": "project", "in": "query", "schema": {"type": "string", "pattern": "^P[0-9]{2}$"}},
          {"name": "provider", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Reviewed public status summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatusSummary"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/monitor-targets": {
      "get": {
        "operationId": "listMonitorTargets",
        "summary": "List visible monitor targets",
        "tags": ["Quality"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "provider", "in": "query", "schema": {"type": "string"}},
          {"name": "outcome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Public target views; bearer tokens may reveal authorized private targets", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MonitorTargetPage"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/monitor-targets/{monitor_id}": {
      "get": {
        "operationId": "getMonitorTarget",
        "summary": "Get a monitor target and reviewed history",
        "tags": ["Quality"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/MonitorId"},
          {"name": "history_limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
        ],
        "responses": {
          "200": {"description": "Target and reviewed observation history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MonitorTargetDetail"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/incidents": {
      "get": {
        "operationId": "listIncidents",
        "summary": "List visible incidents",
        "tags": ["Quality"],
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"name": "status", "in": "query", "schema": {"type": "string"}},
          {"name": "severity", "in": "query", "schema": {"type": "string"}},
          {"name": "source_id", "in": "query", "schema": {"type": "string"}},
          {"name": "opened_from", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "opened_to", "in": "query", "schema": {"type": "string", "format": "date-time"}}
        ],
        "responses": {
          "200": {"description": "Reviewed public incidents or authorized private incidents", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IncidentPage"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/incidents/{incident_id}": {
      "get": {
        "operationId": "getIncident",
        "summary": "Get one visible incident",
        "tags": ["Quality"],
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}],
        "responses": {
          "200": {"description": "Incident view filtered by caller authorization", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/webhook-subscriptions": {
      "get": {
        "operationId": "listWebhookSubscriptions",
        "summary": "List the caller tenant's webhook subscriptions",
        "tags": ["Webhooks"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Limit"}],
        "responses": {"200": {"description": "Tenant webhook subscriptions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSubscriptionList"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      },
      "post": {
        "operationId": "createWebhookSubscription",
        "summary": "Create a webhook subscription",
        "tags": ["Webhooks"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSubscriptionInput"}}}},
        "responses": {
          "201": {"description": "Pending subscription awaiting endpoint challenge", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSubscription"}}}},
          "409": {"description": "Idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/webhook-subscriptions/{subscription_id}/verify": {
      "post": {
        "operationId": "verifyWebhookSubscription",
        "summary": "Challenge and activate a tenant webhook endpoint",
        "tags": ["Webhooks"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "subscription_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Activated subscription", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSubscription"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/webhook-deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
        "summary": "List delivery and dead-letter history for the caller tenant",
        "tags": ["Webhooks"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Limit"}],
        "responses": {"200": {"description": "Tenant webhook delivery history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookDeliveryList"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/audit": {
      "get": {
        "operationId": "listAuditEntries",
        "summary": "List append-only administrative audit evidence",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"name": "target_id", "in": "query", "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Audit entries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditPage"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/sources/{source_id}/approval-decisions": {
      "post": {
        "operationId": "recordSourceApprovalDecision",
        "summary": "Record an audited source approval decision",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/SourceId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceApprovalDecision"}}}},
        "responses": {
          "201": {"description": "Immutable approval decision recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceDetail"}}}},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/admin/monitor-targets/{monitor_id}/activate": {
      "post": {
        "operationId": "activateMonitorTarget",
        "summary": "Activate a monitor with reviewed approval and baseline evidence",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/MonitorId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MonitorActivationInput"}}}},
        "responses": {
          "201": {"description": "Monitor baseline and scheduler activation recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MonitorTargetSummary"}}}},
          "409": {"$ref": "#/components/responses/Conflict"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/admin/sources/{source_id}/connectors": {
      "post": {
        "operationId": "activateConnector",
        "summary": "Activate an approved source recipe and scheduler job",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/SourceId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorActivationInput"}}}},
        "responses": {
          "201": {"description": "Connector version and scheduler job activated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceDetail"}}}},
          "409": {"$ref": "#/components/responses/Conflict"},
          "429": {"$ref": "#/components/responses/TooManyRequests"}
        }
      }
    },
    "/v1/admin/incidents/{incident_id}/acknowledge": {
      "post": {
        "operationId": "acknowledgeIncident",
        "summary": "Acknowledge an open incident",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReasonInput"}}}},
        "responses": {"200": {"description": "Acknowledged incident", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/incidents/{incident_id}/suppress": {
      "post": {
        "operationId": "suppressIncident",
        "summary": "Suppress an incident for a bounded period",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuppressionInput"}}}},
        "responses": {"200": {"description": "Time-bounded suppression recorded", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/incidents/{incident_id}/resolve": {
      "post": {
        "operationId": "resolveIncident",
        "summary": "Resolve an incident with evidence",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResolutionInput"}}}},
        "responses": {"200": {"description": "Resolved incident after recovery gate", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/incidents/{incident_id}/publish": {
      "post": {
        "operationId": "publishIncident",
        "summary": "Publish reviewed bilingual incident wording",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicationInput"}}}},
        "responses": {"200": {"description": "Reviewed wording published", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    },
    "/v1/admin/incidents/{incident_id}/correct": {
      "post": {
        "operationId": "correctIncident",
        "summary": "Correct published incident wording while retaining history",
        "tags": ["Administration"],
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IncidentId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CorrectionInput"}}}},
        "responses": {"200": {"description": "Correction and prior wording recorded", "content": {"application/json": {"schema": {"$ref": "./incident.schema.json"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Audience-bound token issued by the deployment's approved OIDC provider."}
    },
    "parameters": {
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}},
      "SourceId": {"name": "source_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^(HKAPI|EXT)-[0-9]{3}$"}},
      "MonitorId": {"name": "monitor_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^P14-M[0-9]{3}$"}},
      "IncidentId": {"name": "incident_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^INC-[0-9]{4}-[0-9]{6}$"}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string"}, "description": "Current audit version for optimistic concurrency."}
    },
    "responses": {
      "Unauthorized": {"description": "Missing or invalid token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "Insufficient scope or project/tenant access", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Object absent or hidden from caller", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "State or optimistic-concurrency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "TooManyRequests": {"description": "Application request limit exceeded; retry after the number of seconds in Retry-After", "headers": {"Retry-After": {"required": true, "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
