          "rule_version": {"type": ["string", "null"]},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "MonitorTargetPage": {"type": "object", "required": ["items", "page"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/MonitorTargetSummary"}}, "page": {"$ref": "#/components/schemas/PageMeta"}}, "additionalProperties": false},
      "MonitorTargetDetail": {"type": "object", "required": ["target", "observations", "incidents"], "properties": {"target": {"$ref": "#/components/schemas/MonitorTargetSummary"}, "observations": {"type": "array", "items": {"$ref": "./monitor_observation.schema.json"}}, "incidents": {"type": "array", "items": {"$ref": "./incident.schema.json"}}}, "additionalProperties": false},
      "IncidentPage": {"type": "object", "required": ["items", "page"], "properties": {"items": {"type": "array", "items": {"$ref": "./incident.schema.json"}}, "page": {"$ref": "#/components/schemas/PageMeta"}}, "additionalProperties": false},
