      "WebhookDeliveryList": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"type": "object", "required": ["delivery_attempt_id", "subscription_id", "endpoint", "event_id", "event_type", "attempt_number", "status", "first_attempt_at"], "properties": {"delivery_attempt_id": {"type": "string"}, "subscription_id": {"type": "string"}, "endpoint": {"type": "string", "format": "uri"}, "event_id": {"type": "string"}, "event_type": {"type": "string"}, "attempt_number": {"type": "integer", "minimum": 1}, "status": {"enum": ["pending", "processing", "retry", "delivered", "dead_letter"]}, "next_attempt_at": {"type": ["string", "null"], "format": "date-time"}, "first_attempt_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": ["string", "null"], "format": "date-time"}, "response_status": {"type": ["integer", "null"]}}, "additionalProperties": false}}}, "additionalProperties": false},
      "AuditPage": {"type": "object", "required": ["items", "page"], "properties": {"items": {"type": "array", "items": {"type": "object", "required": ["audit_id", "actor", "action", "target_type", "target_id", "reason", "before_hash", "after_hash", "occurred_at", "metadata"], "properties": {"audit_id": {"type": "string"}, "actor": {"type": "string"}, "action": {"type": "string"}, "target_type": {"type": "string"}, "target_id": {"type": "string"}, "reason": {"type": "string"}, "before_hash": {"type": "string"}, "after_hash": {"type": "string"}, "occurred_at": {"type": "string", "format": "date-time"}, "metadata": {"type": "object"}}, "additionalProperties": false}}, "page": {"$ref": "#/components/schemas/PageMeta"}}, "additionalProperties": false},
