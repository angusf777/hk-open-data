      "ResolutionInput": {"type": "object", "required": ["reason", "cause", "evidence_observation_ids"], "properties": {"reason": {"type": "string", "minLength": 1}, "cause": {"type": "string", "minLength": 1}, "evidence_observation_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}}, "additionalProperties": false},
      "PublicationInput": {"type": "object", "required": ["reason", "public_summary"], "properties": {"reason": {"type": "string", "minLength": 1}, "public_summary": {"type": "object", "required": ["en", "zh_Hant"], "properties": {"en": {"type": "string", "minLength": 1}, "zh_Hant": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false},
      "CorrectionInput": {"type": "object", "required": ["reason", "public_summary", "correction_reference"], "properties": {"reason": {"type": "string", "minLength": 1}, "public_summary": {"type": "object", "required": ["en", "zh_Hant"], "properties": {"en": {"type": "string", "minLength": 1}, "zh_Hant": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "correction_reference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
      "Error": {
